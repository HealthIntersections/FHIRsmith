{
  "server": {
    "port": 3000,
    "cors": {
      "origin": true,
      "credentials": true
    }
  },
  // Usage statistics. Request counts are kept per module, per endpoint and per
  // operation, and written to a SQLite database every intervalMinutes so they
  // survive restarts and upgrades. Each row carries both the count for that
  // interval and the all-time total. The whole block is optional.
  "stats": {
    // set false to keep statistics in memory only (nothing is written to disk)
    "enabled": true,
    // relative paths resolve under the data folder's databases directory
    "database": "stats.db",
    // how often the counters are written out
    "intervalMinutes": 10
  },
  "modules": {
    "shl": {
      "enabled": false,
      "database": "shl.db",
      "password": "<!-- Uuid -->",
      "certificates": {
        "certFile": "<!-- filename -->",
        "keyFile": "<!-- filename -->",
        "kid": "<!-- kid -->"
      },
      "vhl": {
        "issuer": "XXX"
      },
      "cleanup": {
        "schedule": "0 * * * *"
      },
      "validator": {
        "enabled": true,
        "version": "4.0.1",
        "txServer": "http://tx.fhir.org/r4",
        "txLog": "./tx.log",
        "port": 8081,
        "packages": [
          "hl7.fhir.us.core#6.0.0",
          "hl7.fhir.uv.ips#1.1.0"
        ],
        "timeout": 60000
      }
    },
    "vcl": {
      "enabled": false
    },
    "xig": {
      "enabled": false,
      "autoUpdate": true
    },
    "packages": {
      "enabled": false,
      "database": "/absolute/path/to/packages.db",
      "mirrorPath": "/absolute/path/to/mirror",
      // shared secret for POST /packages/crawl, which triggers a full registry crawl on
      // demand. Send it in the x-crawl-token header. Omit this and the endpoint is
      // disabled entirely - the scheduled crawler below is unaffected either way.
      "crawlToken": "change-this-to-a-secure-random-string",
      "crawler": {
        "enabled": true,
        "schedule": "0 * * * *"
      }
    },
    "registry": {
      "enabled": true,
      "masterUrl": "https://fhir.github.io/ig-registry/tx-servers.json",
      "crawlInterval": 30,
      "timeout": 30000,
      "userAgent": "YourServer/1.0",
      "apiKeys": {}
    },
    "publisher": {
      "enabled": true,
      "database": "/absolute/path/to/publisher.db",
      // required. Without it the publisher generates a random secret at startup, logs a
      // warning, and logins stop working across restarts.
      "sessionSecret": "change-this-to-a-secure-random-string",
      // session cookies are marked Secure by default, so they only travel over HTTPS.
      // Set false only to run the publisher over plain HTTP - otherwise the browser will
      // not send the cookie back and logins will appear to do nothing. Behind a TLS
      // proxy, make sure it sets X-Forwarded-Proto.
      "cookieSecure": true,
      // failed-login attempts allowed per IP per 15 minutes (default 20)
      "loginAttemptsPerWindow": 20,
      "workspaceRoot": "/absolute/path/to/workspaces",
      "igPublisherTimeoutMinutes": 60,
      // where to put files the IG Publisher leaves in the web folder that are too big for GitHub
      // (>100MB). Only applies to websites whose publish-setup.json has $.website.github = true.
      // Omit to leave them in place - the push will then fail. Relative paths resolve under the
      // publisher data folder
      "large-file-archive": "/absolute/path/to/large-file-archive"
    },
    "npmprojector": {
      "enabled": true,
      "fhirVersion": "r4",  // Options: "r4", "r5", "stu3", "dstu2"
      "basePath": "/fhir",   // Default: "/npmprojector"
      "npmPath": "./data/fhir-package",
      "resourceTypes": null,
      "searchParametersPath": null,
      "debounceMs": 500
    },
    "token": {
      "enabled": true,
      "database": "/absolute/path/to/token.db",
      "sessionSecret": "change-this-to-a-secure-random-string-for-token-sessions",
      "oauth": {
        "google": {
          "clientId": "your-google-client-id",
          "clientSecret": "your-google-client-secret",
          "redirectUri": "http://localhost:3000/token/callback/google",
          "scope": ["openid", "profile", "email"]
        },
        "facebook": {
          "clientId": "your-facebook-app-id",
          "clientSecret": "your-facebook-app-secret",
          "redirectUri": "http://localhost:3000/token/callback/facebook",
          "scope": ["email"]
        },
        "apple": {
          "clientId": "your-apple-service-id",
          "teamId": "your-apple-team-id",
          "keyId": "your-apple-key-id",
          "privateKey": "/path/to/apple-private-key.p8",
          "redirectUri": "http://localhost:3000/token/callback/apple",
          "scope": ["email", "name"]
        },
        "github": {
          "clientId": "your-github-client-id",
          "clientSecret": "your-github-client-secret",
          "redirectUri": "http://localhost:3000/token/callback/github",
          "scope": ["user:email"]
        }
      },
      "apiKeys": {
        "defaultAllowedRequests": 50,
        "maxKeysPerUser": 10,
        "keyExpiration": null
      },
      "rateLimit": {
        "windowMs": 900000,
        "max": 100
      }
    },
    "tx": {
      "enabled": false,
      "librarySource": "/absolute/path/to/library.yml",
      // publish the library source above at <endpoint>/library, so users can see what this
      // server actually loads. One URL, content negotiated: a browser gets a formatted page
      // (and a "Library" item in the tx nav bar), anything else gets the YAML file itself.
      // Off by default - the file names every database, cache and package the server runs.
      "publishLibrarySource": false,
      "cacheTimeout": 30,
      "expansionCacheSize": 1000,
      "expansionCacheMemoryThreshold": 0,
      "endpoints": [
        {
          "path": "/tx/r5",
          "fhirVersion": "5.0",
          "context": null
        },
        {
          "path": "/tx/r4",
          "fhirVersion": "4.0",
          "context": null
        },
        {
          "path": "/tx/r3",
          "fhirVersion": "3.0",
          "context": null
        }
      ]
    },
    "folder" : {
      "enabled": false,
      "folders": [
        {
          "name": "folder",
          "folder": "/tmp/folder",
          "url": "/folder",
          "enabled": true
        }
      ]
    },
    "ext-tracker": {
      "enabled": true,
      "database": "/var/fhir/data/extension-tracker.db",
      "url": "/ext-tracker"
    }
  }
}